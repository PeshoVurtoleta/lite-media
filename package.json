{
  "name": "@zakkster/lite-media",
  "version": "1.0.0",
  "description": "Reactive media & preference signals for @zakkster/lite-signal. Wraps window.matchMedia in a Signal<boolean> with page-lifetime memoization. Zero-GC steady state.",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "type": "module",
  "main": "./Media.js",
  "module": "./Media.js",
  "types": "./Media.d.ts",
  "exports": {
    ".": {
      "types": "./Media.d.ts",
      "node": "./Media.js",
      "import": "./Media.js",
      "default": "./Media.js"
    }
  },
  "files": [
    "Media.js",
    "Media.d.ts",
    "README.md",
    "llms.txt",
    "LICENSE.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "test:gc": "node --expose-gc --test --test-reporter=spec",
    "verify": "npm test && npm run test:gc"
  },
  "keywords": [
    "media-query",
    "matchmedia",
    "reactive",
    "signal",
    "signals",
    "prefers-reduced-motion",
    "prefers-color-scheme",
    "zero-gc",
    "zero-allocation",
    "twitch-extension",
    "responsive",
    "ssr",
    "esm"
  ],
  "homepage": "https://github.com/PeshoVurtoleta/lite-media#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-media.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-media/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@zakkster/lite-signal": "^1.3.0 || ^1.4.0"
  },
  "devDependencies": {
    "@zakkster/lite-signal": "^1.4.0"
  }
}
